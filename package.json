{
  "name": "@eliware/application-template",
  "type": "module",
  "version": "10.0.0",
  "description": "A reusable Node.js application baseline for Eliware projects.",
  "main": "application.mjs",
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "pack": "eliware-test --pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/application-template.git"
  },
  "keywords": [
    "application-template",
    "nodejs",
    "application",
    "starter",
    "template"
  ],
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/application-template/issues"
  },
  "homepage": "https://github.com/eliware/application-template#readme",
  "private": false,
  "engines": {
    "node": "26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "application.mjs",
    "src/main.mjs",
    "docs/",
    "specs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "Dockerfile"
  ],
  "devDependencies": {
    "@eliware/test": "^10.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "dotenv": "^18.0.5"
  },
  "eliware": {
    "apply": [
      "general",
      "application",
      "npm-published",
      "ghcr-published"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  }
}
